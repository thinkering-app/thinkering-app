# Public runtime configuration shipped with the Expo client. Never put secrets here.
EXPO_PUBLIC_API_URL=https://thinkering.app
EXPO_PUBLIC_AI_MODE=proxy

# The organisation's public Featurebase page — the community feedback board.
# Unset hides the community option and leaves the private email channel alone.
EXPO_PUBLIC_FEATUREBASE_PORTAL_URL=https://thinkering.featurebase.app/

# Supabase backup & sync (docs/02). The publishable key (sb_publishable_…) is
# public by design — it ships inside the bundle and RLS is what protects the
# data. Never put the secret key here. Unset leaves Me → Backup at
# export/import only, with the sync half hidden.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Anonymous, opt-in analytics (docs/08). The project API key is public by
# design. Unset makes the wrapper inert — nothing captured, nothing buffered,
# and the one-time ask never appears.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Set to "true" to open the Featurebase portal in the system browser instead of
# the in-app WebView — the fallback if the portal can't offer end-user
# reporting for user-generated content (App Review Guideline 1.2, docs/10).
EXPO_PUBLIC_FEATUREBASE_IN_BROWSER=
