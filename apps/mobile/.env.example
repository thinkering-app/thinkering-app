# Public runtime configuration shipped with the Expo client. Never put secrets here.
EXPO_PUBLIC_API_URL=https://thinkering.app
EXPO_PUBLIC_AI_MODE=proxy

# The organisation's public Featurebase page — the community feedback board.
# Unset hides the community option and leaves the private email channel alone.
EXPO_PUBLIC_FEATUREBASE_PORTAL_URL=https://thinkering.featurebase.app/

# Supabase backup & sync (docs/02). The anon key is public by design — RLS is
# what protects the data. Unset leaves Me → Backup at export/import only.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
