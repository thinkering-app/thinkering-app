# Server-side only — never shipped to a client (docs/02 §Security).
ANTHROPIC_API_KEY=

# Supabase. The secret key (sb_secret_…, Project Settings → API Keys) replaces
# the legacy service_role JWT: it is opaque, individually revocable, and can be
# rotated without invalidating the access tokens the project has issued.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional. Weighted tokens (input + 4 × output) the proxy may spend per UTC
# day across every device; defaults to 20,000,000 (docs/04 §Usage metering).
AI_DAILY_LIMIT_WEIGHTED=

# Sends private feedback, activity reports, and the landing page contact form;
# never expose this to the Expo client.
RESEND_API_KEY=

# Extra browser origins allowed to call the device-facing /api routes, comma
# separated. The Expo web export at web.thinkering.app is always allowed;
# add Vercel preview URLs here. Native clients don't need this.
WEB_APP_ORIGINS=
