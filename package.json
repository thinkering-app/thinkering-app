{
  "name": "thinkering",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify": "turbo run typecheck lint test",
    "format": "prettier --write .",
    "seed": "pnpm --filter @thinkering/db seed",
    "seed:sim": "pnpm --filter @thinkering/mobile seed:sim",
    "ui:tree": "pnpm --filter @thinkering/mobile ui:tree",
    "prompt:run": "pnpm --filter @thinkering/core prompt:run",
    "prompt:check": "pnpm --filter @thinkering/core prompt:check",
    "sync:check": "pnpm --filter @thinkering/db sync:check",
    "e2e": "maestro test -e APP_ID=${APP_ID:-app.thinkering} -e DEV_URL=${DEV_URL:-exp://127.0.0.1:8081/--/} apps/mobile/.maestro"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3"
  }
}
